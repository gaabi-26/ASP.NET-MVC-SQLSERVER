
@{
    ViewBag.Title = "Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item"><a href="index.html">Resumen</a></li>
    <li class="breadcrumb-item active">Usuarios</li>
</ol>

<div class="card">
    <div class="card-header">
        <i class="fas fa-users me-1"></i> Lista Usuarios
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-12">
                <button type="button" class="btn btn-success" onclick="abrirModal(null)">Crear Nuevo</button>
            </div>
        </div>

        <hr />

        <table id="tabla" class="display cell-border" style="width: 100%">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Correo</th>
                    <th>Activo</th>
                    <th>@*Buttons*@</th>
                </tr>
            </thead>
            <tbody>
            </tbody>

        </table>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="FormModal" tabindex="-1" aria-labelledby="exampleModalLabel" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="exampleModalLabel">Crear Usuario</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <input id="txtId" type="hidden" value="0" />
                
                <div class="mb-3">
                    <label for="txtNombres" class="form-label">Nombres</label>
                    <input type="text" class="form-control" id="txtNombres" placeholder="Ingrese nombre..." autocomplete="off">
                </div>

                <div class="mb-3">
                    <label for="txtApellidos" class="form-label">Apellidos</label>
                    <input type="text" class="form-control" id="txtApellidos" placeholder="Ingrese apellido..." autocomplete="off">
                </div>

                <div class="mb-3">
                    <label for="txtCorreo" class="form-label">Correo</label>
                    <input type="email" class="form-control" id="txtCorreo" placeholder="Ingrese correo..." autocomplete="off">
                </div>

                <div>
                    <label for="cboActivo" class="form-label">Activo</label>
                    <select id="cboActivo" class="form-select">
                        <option value="1">Si</option>
                        <option value="0">No</option>
                    </select>
                </div>

            </div>
            <div id="mensajeError" class="alert alert-danger m-2" role="alert">
                A simple danger alert—check it out!
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" onclick="Guardar()">Guardar</button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>

        var tabladata;
        var fila_seleccionada;

        tabladata = $("#tabla").DataTable({
            responsive: true,
            ordering: false,
            "ajax": {
                url: '@Url.Action("ListarUsuarios", "Home")',
                type: 'GET',
                dataType: 'json'
            },
            "columns": [
                { "data": "Nombres" },
                { "data": "Apellidos" },
                { "data": "Correo" },
                { "data": "Activo", "render": (data) => { return data ? '<span class="badge bg-success">Si</span>' : '<span class="badge bg-danger">No</span>' } },
                {
                    "defaultContent": '<button type="button" class="btn btn-primary btn-sm btn-editar"><i class="fas fa-pen"></i></button>' +
                        '<button type="button" class="btn btn-danger btn-sm ms-2 btn-eliminar"><i class="fas fa-trash"></i></button>',
                    "orderable": false,
                    "searchable": false,
                    "width": "90px"
                }
            ],
            language: {
                url: '//cdn.datatables.net/plug-ins/2.2.2/i18n/es-MX.json',
            },
        });

        function abrirModal(data) {

            $("#txtId").val(0)
            $("#txtNombres").val("")
            $("#txtApellidos").val("")
            $("#txtCorreo").val("")
            $("#cboActivo").val(1)
            $("#mensajeError").hide()

            if (data != null) {
                $("#txtId").val(data.IdUsuario)
                $("#txtNombres").val(data.Nombres)
                $("#txtApellidos").val(data.Apellidos)
                $("#txtCorreo").val(data.Correo)
                $("#cboActivo").val(data.Activo == true ? 1:0   )
            }

            $("#FormModal").modal("show");
        }

        $("#tabla tbody").on("click", '.btn-editar', function () {
            fila_seleccionada = $(this).closest("tr");
            var data = tabladata.row(fila_seleccionada).data();
            abrirModal(data);
        });

        $("#tabla tbody").on("click", '.btn-eliminar', function () {
            var usuarioSeleccionado = $(this).closest("tr");
            var data = tabladata.row(usuarioSeleccionado).data();
            swal({
                title: "¿Estas seguro?",
                text: "¿Desea eliminar el usuario?",
                type: "warning",
                showCancelButton: true,
                confirmButtonClass: "btn-primary",
                confirmButtonText: "Si",
                cancelButtonText: "No",
                closeOnConfirm: true
            },
                function () {
                    jQuery.ajax({
                        url: '@Url.Action("EliminarUsuario", "Home")',
                        type: 'POST',
                        data: JSON.stringify({ id: data.IdUsuario }),
                        contentType: 'application/json; charset=utf-8',
                        dataType: 'json',
                        success: function (data) {
                            if (data) {
                                tabladata.row(usuarioSeleccionado).remove().draw();
                                swal("Eliminado!", "El usuario fue eliminado correctamente. ", "success");
                            }
                            else {
                                swal("Error", "No se pudo eliminar el usuario.",  "error");
                            }
                        },
                        error: function (error) {
                            swal("Error", "No se pudo eliminar el usuario.",  "error");
                        },
                    });

                });
        });

        function Guardar() {

            var Usuario = {
                "IdUsuario": $("#txtId").val(),
                "Nombres": $("#txtNombres").val(),
                "Apellidos": $("#txtApellidos").val(),
                "Correo": $("#txtCorreo").val(),
                "Activo": $("#cboActivo").val() == 1 ? true : false,
            }

            jQuery.ajax({
                url: '@Url.Action("GuardarUsuarios", "Home")',
                type: 'POST',
                data: JSON.stringify({ objeto : Usuario }),
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                success: function (data) {
                    $(".modal-body").LoadingOverlay("hide", true);
                    // si el IdUsuario es 0, es nuevo, sino es una actualización
                    if (Usuario.IdUsuario == 0)
                    {
                        if (data.resultado != 0)
                        {
                            Usuario.IdUsuario = data.resultado; // agregamos el IdUsuario al objeto
                            tabladata.row.add(Usuario).draw(false);
                            $("#FormModal").modal("hide");
                        }
                        else
                        {
                            $("#mensajeError").text(data.mensaje    )
                            $("#mensajeError").show()
                        }
                    }
                    // si no es 0, es una actualización
                    else
                    {
                        if (data.resultado) {
                            tabladata.row(fila_seleccionada).data(Usuario).draw(false);
                            fila_seleccionada = null;
                            $("#FormModal").modal("hide");
                        }
                        else {
                            $("#mensajeError").text(data.mensaje)
                            $("#mensajeError").show()
                        }
                    }
                },
                error: function (error) {
                    $(".modal-body").LoadingOverlay("hide", true);
                    $("#mensajeError").text("Error ajax.")
                    $("#mensajeError").show()
                },
                beforeSend: function () {
                    // acciones que se van a ejecutar antes y durante de enviar la petición
                    // Let's call it 2 times just for fun...
                    $(".modal-body").LoadingOverlay("show", {
                        imageResizeFactor: 2,
                        text: "Cargando...",
                        size: 10
                    });

                    // Here we might call the "hide" action 2 times, or simply set the "force" parameter to true:
                    //$("#element").LoadingOverlay("hide", true);
                },
            });



        }

    </script>
}
